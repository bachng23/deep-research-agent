# Required — key for the OpenAI-compatible LLM endpoint (default: OpenRouter)
API_KEY=

# Optional — endpoint base URL.
# LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional — force every node onto one tier.
# MODEL_TIER_OVERRIDE=fast
# MODEL_TIER_OVERRIDE=balanced
# MODEL_TIER_OVERRIDE=reasoning

# Optional — per-tier model names.
FAST_MODEL=deepseek/deepseek-v4-flash
BALANCED_MODEL=deepseek/deepseek-v4-pro
REASONING_MODEL=deepseek/deepseek-v4-pro

# Optional — provider limits/timeouts.
ARXIV_MAX_RESULTS=8
OPENALEX_MAX_RESULTS=8
# HTTP timeout for ArXiv/OpenAlex, NOT for the LLM.
REQUEST_TIMEOUT_SECONDS=20

# Optional — LLM call timeout. Reasoning-tier gap analysis with verbatim
# quotes routinely runs past a provider HTTP timeout, and each timeout costs
# 3 attempts before it surfaces. Keep this well above REQUEST_TIMEOUT_SECONDS.
LLM_TIMEOUT_SECONDS=180

# Optional — cross-session memory (paper index + prior-gap recall).
# The TUI enables it regardless; eval runs force it off.
USE_MEMORY=false
MEMORY_DIR=.paper_research_memory
RESULT_CACHE_TTL_DAYS=7

# Optional — OpenAlex API key (higher rate limits).
OPENALEX_API_KEY=

# Optional — LangSmith tracing.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=paper-research-agent
